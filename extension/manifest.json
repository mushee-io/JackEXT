{
  "manifest_version": 3,
  "name": "JackEXT — Shopping Scout",
  "description": "Compare a product you are viewing with transparent offers and make a quote draft.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*", "https://*.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Scan with JackEXT" }
}
